{
  "name": "cdx-chores",
  "version": "0.1.5-canary.3",
  "keywords": [
    "automation",
    "cli",
    "codex",
    "data-conversion",
    "duckdb",
    "ffmpeg",
    "file-processing",
    "file-rename",
    "markdown",
    "video"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-pi2pie/cdx-chores"
  },
  "bin": {
    "cdx-chores": "dist/esm/bin.mjs"
  },
  "files": [
    "dist",
    "LICENSE*",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/esm/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.mts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/generate-embedded-version.mjs && tsdown",
    "cli": "node dist/esm/bin.mjs",
    "lint": "oxlint --tsconfig tsconfig.json src test scripts",
    "lint:fix": "oxlint --tsconfig tsconfig.json --fix src test scripts",
    "format": "oxfmt src test scripts package.json tsconfig.json .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check src test scripts package.json tsconfig.json .oxlintrc.json .oxfmtrc.json"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.3-r.3",
    "@inquirer/prompts": "8.5.2",
    "@openai/codex-sdk": "^0.139.0",
    "@shikijs/transformers": "^4.2.0",
    "commander": "^15.0.0",
    "fast-xml-parser": "5.8.0",
    "mammoth": "^1.12.0",
    "papaparse": "^5.5.3",
    "parse5": "^8.0.1",
    "pdfjs-dist": "^6.0.227",
    "shiki": "^4.2.0",
    "yaml": "^2.9.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "25.9.2",
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "picocolors": "^1.1.1",
    "tsdown": "0.22.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
