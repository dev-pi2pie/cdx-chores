{
  "name": "cdx-chores",
  "version": "0.2.2-canary.3",
  "keywords": [
    "automation",
    "cli",
    "codex",
    "data-conversion",
    "duckdb",
    "ffmpeg",
    "file-processing",
    "file-rename",
    "markdown",
    "video"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-pi2pie/cdx-chores"
  },
  "bin": {
    "cdx-chores": "dist/esm/bin.mjs"
  },
  "files": [
    "dist",
    "LICENSE*",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/esm/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.mts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/generate-embedded-version.mjs && tsdown",
    "cli": "node dist/esm/bin.mjs",
    "test:unit": "bun scripts/testing/run.ts unit",
    "test:integration:app": "bun scripts/testing/run.ts app",
    "test:integration:codex": "bun scripts/testing/run.ts codex",
    "test:integration:pandoc": "bun scripts/testing/run.ts pandoc",
    "test:all": "bun scripts/testing/run.ts all",
    "lint": "oxlint --tsconfig tsconfig.json src test scripts",
    "lint:fix": "oxlint --tsconfig tsconfig.json --fix src test scripts",
    "format": "oxfmt src test scripts package.json tsconfig.json .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check src test scripts package.json tsconfig.json .oxlintrc.json .oxfmtrc.json"
  },
  "dependencies": {
    "@duckdb/node-api": "^2.0.0-r.1",
    "@inquirer/prompts": "8.8.0",
    "@inquirer/search": "4.4.0",
    "@openai/codex-sdk": "^0.167.2",
    "@shikijs/transformers": "^4.6.0",
    "commander": "^15.1.0",
    "dingbat-to-unicode": "1.0.2",
    "fast-xml-parser": "5.12.0",
    "fast-xml-validator": "1.4.2",
    "papaparse": "^5.7.1",
    "parse5": "^8.1.1",
    "pdfjs-dist": "^6.5.438",
    "shiki": "^4.6.0",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "picocolors": "^1.1.1",
    "tsdown": "0.23.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.23.5"
  }
}
